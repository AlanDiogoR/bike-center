# URL da API (backend)
NEXT_PUBLIC_API_URL=http://localhost:3333

# Hostname da API para otimização de imagens (next/image)
# Em produção: api.bikecenter.com.br
NEXT_PUBLIC_API_HOSTNAME=localhost

# URL do site (para SEO, sitemap e canonical)
# Sem barra no final — evita vercel.app//produtos no sitemap
# Em produção: https://bike-center-web.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
